# Copy to windows_client/.env and fill in. Never commit .env.
# Do NOT put this file inside the Obsidian vault.

VAULT_ROOT=C:\Users\hsuga\Documents\Obsidian\WorkVault
# Base URL of the API (https only; http is allowed only for localhost)
VAULT_API_URL=https://vault.example.com/api/vault
# A *sync* key from the server's VAULT_SYNC_KEYS (the part after "windows-pc:")
VAULT_API_KEY=

# Wait this long after the last change before sending (seconds)
VAULT_DEBOUNCE_SECONDS=2.5
# Full rescan interval as a safety net for missed events (seconds)
VAULT_RESCAN_INTERVAL_SECONDS=600

# Extra paths never to sync, comma separated, relative to the vault.
# "*" also matches "/", e.g. 04_AI-Chats/Claude_Export_*
VAULT_EXTRA_EXCLUDES=

# Skip notes that look like they contain API keys, private keys or card numbers
VAULT_SECRET_SCAN=true
# Paths exempt from the secret scan (false positives), same glob syntax
VAULT_SECRET_SCAN_ALLOW=

# State and log location (default: %LOCALAPPDATA%\obsidian-vault-bridge)
# VAULT_DATA_DIR=
# Custom CA bundle for a private certificate authority
# VAULT_CA_BUNDLE=
