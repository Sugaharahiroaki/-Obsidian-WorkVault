# Copy to vault_api/.env and fill in. Never commit .env.
# Generate random values with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=vault.example.com

# Database: sqlite (default, FTS5 search) or postgresql
VAULT_DB_ENGINE=sqlite
VAULT_DB_PATH=/var/lib/vault_api/db.sqlite3

# Public URL (OAuth issuer and MCP resource). Required in production.
VAULT_PUBLIC_URL=https://vault.example.com

# Owner password hash for the OAuth consent screen (ChatGPT / Claude apps connect via
# https://vault.example.com/api/vault/mcp). Create with: python manage.py vault_owner_password
VAULT_OWNER_PASSWORD_HASH=
# VAULT_OAUTH_REDIRECT_HOSTS=chatgpt.com,claude.ai

# Static API keys (no OAuth): client-name:key, comma separated, key >= 32 chars.
# sync = Windows client; write = read + create/append/update; read = read only (Codex, Claude Code).
VAULT_SYNC_KEYS=windows-pc:
VAULT_WRITE_KEYS=
VAULT_READ_KEYS=codex:

# HTTPS. Keep VAULT_REQUIRE_HTTPS=true in production.
VAULT_REQUIRE_HTTPS=true
# true when nginx terminates TLS and sends X-Forwarded-Proto
VAULT_SECURE_PROXY_SSL_HEADER=true
# Number of trusted reverse proxies (for client IP in access logs)
VAULT_TRUSTED_PROXY_COUNT=1

# Limits
VAULT_MAX_NOTE_BYTES=2097152
VAULT_MAX_BATCH_NOTES=100
VAULT_MAX_REQUEST_BYTES=10485760

VAULT_LOG_LEVEL=INFO
